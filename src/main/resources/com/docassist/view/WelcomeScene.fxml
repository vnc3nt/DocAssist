<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!-- Das Wurzelelement ist ein BorderPane. Es wird mit dem Controller verknüpft. -->

<BorderPane maxHeight="700.0" maxWidth="1050.0" minHeight="400.0" minWidth="600.0" prefHeight="480.0" prefWidth="720.0" style="-fx-padding: 30; -fx-font-family: 'Arial'; -fx-font-size: 16;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.docassist.controller.WelcomeController">
   
   <!-- Oberer Bereich des BorderPane -->
   <top>
      <Text text="Willkommen bei DocAssist" BorderPane.alignment="CENTER">
         <font>
            <Font name="Arial Bold" size="22.0" />
         </font>
      </Text>
   </top>

   <!-- Mittlerer Bereich des BorderPane -->
   <center>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="400.0" spacing="50.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="BOTTOM_CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <!-- Die Buttons rufen bei Klick die Methoden im Controller auf -->
                  <Button fx:id="btnOpen" mnemonicParsing="false" onAction="#handleOpen">
                     <graphic>
                        <ImageView fitHeight="109.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../assets/icons/open-doc.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Dokument einlesen" wrappingWidth="136.96875">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Text>
               </children>
               <HBox.margin>
                  <Insets bottom="50.0" />
               </HBox.margin>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Button fx:id="btnNew" mnemonicParsing="false" onAction="#handleNew">
                     <graphic>
                        <ImageView fitHeight="109.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../assets/icons/new-doc.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="neues Dokument" wrappingWidth="120.9609375">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Text>
               </children>
               <HBox.margin>
                  <Insets bottom="50.0" />
               </HBox.margin>
            </VBox>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </HBox>
   </center>
   <bottom>
      <VBox maxHeight="150.0" minHeight="100.0" prefHeight="150.0" BorderPane.alignment="CENTER">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="zuletzt geöffnet">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" />
               </VBox.margin>
            </Text>
            <ScrollPane maxHeight="150.0" minHeight="100.0" prefHeight="150.0">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="125.0" prefWidth="125.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </AnchorPane>
              </content>
            </ScrollPane>
         </children>
      </VBox>
   </bottom>
</BorderPane>
